# ==========================================================
# Dependencies
# ==========================================================
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions
!.yarn/sdks

# ==========================================================
# Environment variables (NEVER commit real secrets)
# ==========================================================
.env
.env.*
!.env.example
!.env.template
!.env.*.example

# Vercel / platform secrets
*.pem
*.key
*.crt
*.p12
secrets.json
secrets.yaml

# ==========================================================
# Next.js build output / cache
# ==========================================================
.next/
out/
build/
dist/
next-env.d.ts

# ==========================================================
# Testing / coverage
# ==========================================================
coverage/
.nyc_output/
*.lcov

# ==========================================================
# Production logs & debugging
# ==========================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================================
# Caches
# ==========================================================
.cache/
.temp/
.tmp/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# mongodb-memory-server downloads a mongod binary into the cache dir
mongodb-binaries/
node_modules/.cache/mongodb-memory-server/

# Next.js / Turbopack / webpack / Turbo persistent caches
.turbo/
.swc/

# ==========================================================
# Drizzle ORM
# ==========================================================
# migration SQL files are generated by drizzle-kit and SHOULD be committed
drizzle/meta/_journal.json.bak
*.sql.bak
dump.rdb
dump/

# Local Postgres / Mongo data directories
pgdata/
data/db/
data/mongodb/
.mongodb/

# ==========================================================
# Editors & IDEs
# ==========================================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.atom/
*.swp
*.swo
*~

# ==========================================================
# OS files
# ==========================================================
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ==========================================================
# Hosting platforms
# ==========================================================
.vercel/
.netlify/

# ==========================================================
# Miscellaneous
# ==========================================================
*.bak
*.orig
*.rej