# ==============================================================================
#  sanidev-weblog — environment template
#
#  Copy this file and fill it in:      cp .env.example .env
#
#  Local setup, in order:
#    1. createdb sanidev            # or: psql -c 'CREATE DATABASE sanidev'
#    2. npm install                 # runs `prisma generate` (postinstall)
#    3. npm run db:setup            # prisma migrate dev  +  prisma db seed
#    4. npm run dev
# ==============================================================================


# ── Database ─────────────────────────────────────────────────────────────────
# Local PostgreSQL. Adjust role / password / port to match your machine.
# Prisma 7 reads this through prisma.config.ts (CLI) and @prisma/adapter-pg (app).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sanidev"


# ── Site ─────────────────────────────────────────────────────────────────────
# Absolute base URL for RSS feed, sitemap.xml and robots.txt.
SITE_URL="http://localhost:3000"


# ── Seed accounts (`npm run db:seed`) ────────────────────────────────────────
# These are the logins the seed creates:
#   admin  — full access: edit/delete every post, /write, /studio
#   writer — a normal account: can only touch its own posts
#
# When a variable is left empty the seed falls back to the defaults above.
# Change them before deploying anywhere real — the fallbacks are public.
SEED_ADMIN_EMAIL="sani@sanidev.blog"
SEED_ADMIN_PASSWORD="sani1234"
SEED_WRITER_EMAIL="writer@sanidev.blog"
SEED_WRITER_PASSWORD="writer1234"


# ── Development ──────────────────────────────────────────────────────────────
# In development the first database call seeds an empty database automatically,
# so `npm run dev` is never a blank site. Set to 0 to turn that off.
AUTO_SEED="1"
