{
  "name": "blog-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:demo": "tsx prisma/demo.ts",
    "db:migrate": "prisma migrate dev",
    "db:auth-gen": "auth generate --adapter prisma --config ./src/lib/auth.ts --output ./auth/auth.generated.prisma -y",
    "db:admin": "auth create-admin --config ./src/lib/auth.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.7",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.7",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
